---
import { getCollection, render } from "astro:content";
import { marked } from "marked";
import ProjectPage from "../../layouts/ProjectPage.astro";
import PostCard from "../../components/PostCard.astro";
import ContentWarningGate from "../../components/ContentWarningGate.astro";

export async function getStaticPaths() {
  const projectPosts = await getCollection(
    "projects",
    ({ data }) => !data.draft,
  );
  const allReleases = await getCollection(
    "releases",
    ({ data }) => !data.draft,
  );

  return projectPosts.map((post) => {
    const releases = allReleases
      .filter((r) => r.data.projectTag === post.data.projectTag)
      .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

    return {
      params: { slug: post.id.replace(/\.(md|mdx)$/, "") },
      props: { post, releases },
    };
  });
}

const { post, releases } = Astro.props;

const hasLocalContent = Boolean(post.body?.trim().length);

let Content: any;
let readmeHtml = "";
if (hasLocalContent) {
  ({ Content } = await render(post));
} else if (post.data.repo) {
  const rawUrl =
    post.data.repo
      .replace("https://github.com", "https://raw.githubusercontent.com")
      .replace(/\/$/, "") + "/main/README.md";
  const res = await fetch(rawUrl);
  if (res.ok) {
    readmeHtml = await marked(await res.text());
  }
}
---

<ProjectPage title={post.data.title} description={post.data.description}>
  <header class="project-header">
    <h1>{post.data.title}</h1>
    {
      post.data.site && (
        <a href={post.data.site} target="_blank" rel="noopener noreferrer">
          Visit site
        </a>
      )
    }
    {
      post.data.repo && (
        <a href={post.data.repo} target="_blank" rel="noopener noreferrer">
          View repo
        </a>
      )
    }
    {
      post.id.replace(/\.(md|mdx)$/, "") === "sniffies-project" && (
        <a href="/projects/sniffies-project/install/">Install</a>
      )
    }
  </header>
  <ContentWarningGate warningKey={post.data.contentWarning}>
    {
      hasLocalContent && (
        <div class="project-content">
          <Content />
        </div>
      )
    }
    {readmeHtml && <div class="project-content" set:html={readmeHtml} />}
    {
      releases.length > 0 && (
        <section class="releases">
          <h2>Releases</h2>
          <div class="release-cards">
            {releases.map((r, i) => (
              <PostCard
                type="release"
                variant={i === 0 ? "card" : "card-sm"}
                title={r.data.title}
                date={r.data.date}
                description={r.data.description}
                slug={r.id.replace(/\.(md|mdx)$/, "")}
                repo={r.data.repo}
              />
            ))}
          </div>
        </section>
      )
    }
  </ContentWarningGate>
</ProjectPage>

<style>
  .project-header {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    margin-bottom: 2rem;
  }

  .project-header h1 {
    margin: 0;
    font-size: 1.5rem;
  }

  .project-header a {
    font-size: 0.85rem;
    color: var(--color-muted);
  }

  .releases {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .releases h2 {
    font-size: 1.1rem;
    margin: 0 0 1rem;
  }

  .release-cards {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .project-content :global(h1) {
    font-size: 1.5rem;
    margin-top: 2rem;
  }
  .project-content :global(h2) {
    font-size: 1.25rem;
    margin-top: 1.75rem;
  }
  .project-content :global(h3) {
    font-size: 1.05rem;
    margin-top: 1.5rem;
  }
  .project-content :global(p) {
    margin: 1rem 0;
  }
  .project-content :global(ul),
  .project-content :global(ol) {
    padding-left: 1.5rem;
  }
  .project-content :global(img) {
    max-width: 100%;
  }
  .project-content :global(pre) {
    background: var(--color-surface);
    padding: 1rem;
    border-radius: 4px;
    overflow-x: auto;
  }
  .project-content :global(code) {
    font-family: var(--font-mono);
    font-size: 0.875em;
  }
  .project-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0;
    font-size: 0.9rem;
  }
  .project-content :global(th),
  .project-content :global(td) {
    border: 1px solid var(--color-border);
    padding: 0.5rem 0.75rem;
    text-align: left;
  }
  .project-content :global(th) {
    background: var(--color-surface);
  }
</style>
