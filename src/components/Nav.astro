---
import ThemeToggle from "./ThemeToggle.astro";
const { pathname } = Astro.url;
---

<nav>
  <div class="links">
    <a href="/" class={pathname === "/" ? "active" : ""}>Home</a>
    <a href="/blog" class={pathname.startsWith("/blog") ? "active" : ""}>Blog</a
    >
    <a href="/projects" class={pathname.startsWith("/projects") ? "active" : ""}
      >Projects</a
    >
    <a href="/releases" class={pathname.startsWith("/releases") ? "active" : ""}
      >Releases</a
    >
  </div>
  <ThemeToggle />
</nav>

<style>
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.5rem 0;
  }

  .links {
    display: flex;
    gap: 1.5rem;
  }

  a {
    text-decoration: none;
    font-size: 0.9rem;
    color: var(--color-muted);
  }

  a.active,
  a:hover {
    color: var(--color-text);
    opacity: 1;
  }
</style>
