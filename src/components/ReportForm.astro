---
import { reportTypes, type ReportTypeKey } from "../content/reportTypes";

interface Props {
  type: ReportTypeKey;
}

const { type } = Astro.props;
const { title, subtitle, summaryLabel } = reportTypes[type];
---

<section>
  <h1>{title}</h1>
  {subtitle && <p class="subtitle">{subtitle}</p>}

  <form class="report-form" data-type={type}>
    <label>
      {summaryLabel}
      <textarea name="summary" required rows="6" maxlength="4000"></textarea>
    </label>
    <label>
      Contact (optional)
      <input name="contact" type="text" placeholder="Email, Discord, etc." />
    </label>
    <!-- Bullshit catcher -->
    <input
      name="website"
      type="text"
      tabindex="-1"
      autocomplete="off"
      class="hp"
    />
    <button type="submit">Submit report</button>
    <p class="report-status" role="status"></p>
  </form>
</section>

<script>
  document.querySelectorAll<HTMLFormElement>(".report-form").forEach((form) => {
    const status = form.querySelector<HTMLElement>(".report-status")!;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      status.textContent = "Sending...";

      try {
        const res = await fetch("/api/reports", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            type: form.dataset.type,
            summary: data.get("summary"),
            contact: data.get("contact"),
            website: data.get("website"),
          }),
        });

        if (!res.ok) throw new Error();
        form.reset();
        status.textContent = "Thanks — your report was submitted.";
      } catch {
        status.textContent = "Something went wrong. Please try again.";
      }
    });
  });
</script>

<style>
  section {
    padding-top: 2rem;
  }

  h1 {
    font-size: 1.5rem;
    margin: 0 0 0.5rem;
  }

  .subtitle {
    color: var(--color-muted);
    margin: 0 0 1.5rem;
  }

  form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  label {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.9rem;
  }

  input,
  textarea {
    font: inherit;
    font-size: 0.95rem;
    padding: 0.5rem 0.6rem;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    background: var(--color-bg);
    color: var(--color-text);
  }

  textarea {
    resize: vertical;
  }

  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  button {
    align-self: flex-start;
    font: inherit;
    font-size: 0.9rem;
    cursor: pointer;
    background: var(--color-accent);
    color: var(--color-accent-text);
    border: none;
    border-radius: 4px;
    padding: 0.6rem 1.25rem;
  }

  .report-status {
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-muted);
  }
</style>
