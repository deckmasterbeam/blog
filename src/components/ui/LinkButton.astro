---
interface Props {
  href: string;
  label: string;
}

const { href, label } = Astro.props;
---

<a href={href} class="link-button">{label}</a>

<style>
  .link-button {
    display: inline-block;
    padding: 0.6rem 1.25rem;
    background: var(--color-accent);
    color: var(--color-accent-text);
    text-decoration: none;
    border-radius: 5px;
    font-size: 0.9rem;
    font-weight: 500;
  }

  .link-button:hover {
    opacity: 0.8;
  }
</style>
